rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // A permissão administrativa depende do e-mail confirmado pelo Google,
    // nunca de um campo que o próprio usuário possa gravar no Firestore.
    function isAdmin() {
      return logado()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == "deliciasdavo54@gmail.com";
    }

    function equipeAtiva() {
      return logado()
        && exists(/databases/$(database)/documents/equipe/$(request.auth.uid))
        && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.ativo == true;
    }

    function podePedidos() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.pedidos == true);
    }

    function podeCozinha() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.cozinha == true);
    }

    function podeEntregas() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.entregas == true);
    }

    function podeCaixa() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.caixa == true);
    }

    function podeEstoque() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.estoque == true);
    }

    function podeCompras() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.compras == true);
    }

    function podeFinanceiro() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.financeiro == true);
    }

    function podeClientes() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.clientes == true);
    }

    function podeRelatorios() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.relatorios == true);
    }

    function podeConfiguracoes() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.configuracoes == true);
    }

    function podeSite() {
      return isAdmin() || (equipeAtiva() && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.permissoes.site == true);
    }

    function conviteEquipeAtivo() {
      return logado()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/convitesEquipe/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/convitesEquipe/$(request.auth.token.email.lower())).data.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/convitesEquipe/$(request.auth.token.email.lower())).data.ativo == true
        && get(/databases/$(database)/documents/convitesEquipe/$(request.auth.token.email.lower())).data.status == "pendente";
    }

    function ativacaoConviteEquipeValida(uid) {
      return conviteEquipeAtivo()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          "uid", "nome", "email", "foto", "cargo", "ativo", "permissoes",
          "conviteEmail", "origemAcesso", "criadoEm", "atualizadoEm"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.conviteEmail == request.auth.token.email.lower()
        && request.resource.data.origemAcesso == "convite"
        && request.resource.data.nome is string
        && request.resource.data.foto is string
        && request.resource.data.ativo == true
        && request.resource.data.cargo == get(/databases/$(database)/documents/convitesEquipe/$(request.auth.token.email.lower())).data.cargo
        && request.resource.data.permissoes == get(/databases/$(database)/documents/convitesEquipe/$(request.auth.token.email.lower())).data.permissoes
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
    }

    function podeOperacao() {
      return podePedidos() || podeCozinha() || podeEntregas();
    }

    function podeConsultarPedidos() {
      return podeOperacao() || podeClientes() || podeRelatorios();
    }

    function movimentoAutomaticoPedidoValido(movimentoId) {
      return movimentoId.matches('pedido-.*')
        && request.resource.data.tipo == "entrada"
        && request.resource.data.origem in ["pedido-site", "pedido-manual"]
        && (
          (request.resource.data.origem == "pedido-site" && movimentoId.matches('pedido-site-.*'))
          || (request.resource.data.origem == "pedido-manual" && movimentoId.matches('pedido-manual-.*'))
        )
        && request.resource.data.pedidoId is string
        && request.resource.data.valor is number
        && request.resource.data.valor >= 0;
    }

    function movimentoAutomaticoCompraValido(movimentoId) {
      return movimentoId.matches('compra-.*')
        && request.resource.data.tipo == "saida"
        && request.resource.data.origem == "compra-gestao"
        && request.resource.data.compraId is string
        && request.resource.data.valor is number
        && request.resource.data.valor >= 0;
    }

    function atualizacaoEstoqueProdutoValida() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estoque", "variacoes", "atualizadoEm"
        ])
        && request.resource.data.atualizadoEm == request.time;
    }

    function enderecoValido(endereco) {
      return endereco is map
        && endereco.keys().hasOnly(["rua", "numero", "bairro", "complemento"])
        && endereco.rua is string && endereco.rua.size() <= 160
        && endereco.numero is string && endereco.numero.size() <= 30
        && endereco.bairro is string && endereco.bairro.size() <= 100
        && endereco.complemento is string && endereco.complemento.size() <= 180;
    }

    function perfilNovoValido(uid) {
      return request.resource.data.keys().hasOnly([
          "uid", "nome", "email", "foto", "tipo", "telefone", "endereco",
          "criadoEm", "atualizadoEm"
        ])
        && request.resource.data.keys().hasAll([
          "uid", "nome", "email", "foto", "tipo", "telefone", "endereco",
          "criadoEm", "atualizadoEm"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 120
        && request.resource.data.foto is string
        && request.resource.data.foto.size() <= 2000
        && request.resource.data.telefone is string
        && request.resource.data.telefone.size() <= 30
        && enderecoValido(request.resource.data.endereco)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time
        && (
          (isAdmin() && request.resource.data.tipo == "admin")
          || (!isAdmin() && request.resource.data.tipo == "cliente")
        );
    }

    function atualizacaoPerfilValida(uid) {
      return request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 120
        && request.resource.data.foto is string
        && request.resource.data.foto.size() <= 2000
        && request.resource.data.telefone is string
        && request.resource.data.telefone.size() <= 30
        && enderecoValido(request.resource.data.endereco)
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nome", "foto", "telefone", "endereco", "atualizadoEm"
        ]);
    }

    function atualizacaoObservacaoClienteValida() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "observacaoGestao", "atualizadoEm"
        ])
        && request.resource.data.observacaoGestao is string
        && request.resource.data.observacaoGestao.size() <= 1000
        && request.resource.data.atualizadoEm == request.time;
    }

    function pedidoSiteValido(dataPedido, pedidoId) {
      return request.resource.data.keys().hasOnly([
          "origem", "loja", "cliente", "tipo", "endereco", "enderecoDetalhado",
          "pagamento", "itens", "subtotalProdutos", "taxaEntrega", "distanciaEntregaKm",
          "total", "usuarioId", "id", "numero",
          "numeroFormatado", "status", "dataISO", "dataBR", "horaBR",
          "criadoEmMs", "criadoEm"
        ])
        && request.resource.data.keys().hasAll([
          "origem", "loja", "cliente", "tipo", "endereco", "pagamento",
          "itens", "total", "id", "numero", "numeroFormatado", "status",
          "dataISO", "dataBR", "horaBR", "criadoEmMs", "criadoEm"
        ])
        && request.resource.data.origem == "site"
        && request.resource.data.id == pedidoId
        && request.resource.data.dataISO == dataPedido
        && request.resource.data.numero is string
        && request.resource.data.numero.size() <= 40
        && request.resource.data.numeroFormatado == request.resource.data.numero
        && request.resource.data.status == "registrado"
        && request.resource.data.loja is string
        && request.resource.data.loja.size() <= 120
        && request.resource.data.cliente is map
        && request.resource.data.cliente.nome is string
        && request.resource.data.cliente.nome.size() > 0
        && request.resource.data.cliente.nome.size() <= 120
        && request.resource.data.tipo in ["Retirada na loja", "Entrega"]
        && request.resource.data.endereco is string
        && request.resource.data.endereco.size() <= 500
        && request.resource.data.pagamento in ["Pix", "Dinheiro", "Cartão"]
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 60
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && (!request.resource.data.keys().hasAny(["subtotalProdutos"]) || request.resource.data.subtotalProdutos is number)
        && (!request.resource.data.keys().hasAny(["taxaEntrega"]) || request.resource.data.taxaEntrega == null || request.resource.data.taxaEntrega is number)
        && (!request.resource.data.keys().hasAny(["distanciaEntregaKm"]) || request.resource.data.distanciaEntregaKm == null || request.resource.data.distanciaEntregaKm is number)
        && request.resource.data.criadoEmMs is int
        && request.resource.data.criadoEm == request.time;
    }

    function encomendaFestaValida() {
      return request.resource.data.keys().hasOnly([
          "cliente", "dataFesta", "tipoEntrega", "endereco", "enderecoDetalhado",
          "observacoes", "itens", "totalUnidades", "totalEstimado", "usuarioId",
          "numero", "status", "visualizado", "criadoEmMs", "criadoEm", "atualizadoEm"
        ])
        && request.resource.data.keys().hasAll([
          "cliente", "dataFesta", "tipoEntrega", "endereco", "observacoes",
          "itens", "totalUnidades", "totalEstimado", "numero", "status",
          "visualizado", "criadoEmMs", "criadoEm", "atualizadoEm"
        ])
        && request.resource.data.cliente is map
        && request.resource.data.cliente.nome is string
        && request.resource.data.cliente.nome.size() > 0
        && request.resource.data.cliente.nome.size() <= 120
        && request.resource.data.cliente.telefone is string
        && request.resource.data.cliente.telefone.size() <= 30
        && request.resource.data.numero is string
        && request.resource.data.numero.size() <= 40
        && request.resource.data.status == "aguardando_confirmacao"
        && request.resource.data.visualizado == false
        && request.resource.data.tipoEntrega in ["Retirada na loja", "Entrega"]
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 100
        && request.resource.data.totalUnidades is number
        && request.resource.data.totalUnidades > 0
        && request.resource.data.totalUnidades <= 100000
        && request.resource.data.totalEstimado is number
        && request.resource.data.totalEstimado >= 0
        && request.resource.data.totalEstimado <= 1000000
        && request.resource.data.criadoEmMs is int
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
    }

    match /usuarios/{uid} {
      allow create: if isAdmin() || (logado() && request.auth.uid == uid && perfilNovoValido(uid));
      allow read: if logado() && (request.auth.uid == uid || isAdmin() || podeClientes());
      allow update: if logado() && (isAdmin() || atualizacaoPerfilValida(uid) || (podeClientes() && atualizacaoObservacaoClienteValida()));
      allow delete: if isAdmin();
    }

    match /produtos/{id} {
      allow read: if true;
      allow create, delete: if isAdmin() || podeSite();
      allow update: if isAdmin() || podeEstoque() || podeSite()
        || (podeOperacao() && atualizacaoEstoqueProdutoValida());
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if isAdmin() || podeSite();
    }

    match /promocoes/{id} {
      allow read: if true;
      allow write: if isAdmin() || podeSite();
    }

    match /configuracoes/{id} {
      allow read: if true;
      allow write: if isAdmin()
        || (id == "operacao" && podeConfiguracoes())
        || (id != "operacao" && podeSite());
    }

    match /salgadosFesta/{produtoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || podeSite();
    }

    // Contadores antigos ficam preservados para histórico, mas deixam de aceitar
    // alterações públicas. Os novos pedidos usam códigos únicos sem contador global.
    match /contadoresPedidos/{data} {
      allow read, write: if isAdmin();
    }

    match /pedidosSite/{dataPedido} {
      allow read: if podeConsultarPedidos();

      match /pedidos/{pedidoId} {
        allow create: if isAdmin() || pedidoSiteValido(dataPedido, pedidoId);
        allow read: if podeConsultarPedidos();
        allow update: if podeOperacao();
        allow delete: if isAdmin();
      }
    }

    match /{caminho=**}/pedidos/{pedidoId} {
      allow read: if podeConsultarPedidos();
    }

    match /pedidosManuais/{pedidoId} {
      allow read: if podeConsultarPedidos();
      allow create: if podePedidos();
      allow update: if podePedidos() || podeCozinha() || podeEntregas();
      allow delete: if isAdmin();
    }

    match /vendas/{id} {
      allow read: if isAdmin() || podeCaixa() || podeFinanceiro() || podeRelatorios();
      allow create, update: if isAdmin() || podeCaixa();
      allow delete: if isAdmin() || podeFinanceiro();
    }

    match /contadores/{id} {
      allow read, write: if isAdmin();
    }

    match /encomendasFesta/{pedidoId} {
      allow create: if isAdmin() || encomendaFestaValida();
      allow read: if podeConsultarPedidos();
      allow update: if podeOperacao();
      allow delete: if isAdmin();
    }

    match /movimentosFinanceiros/{movimentoId} {
      allow read: if isAdmin() || podeFinanceiro() || podeCaixa() || podeRelatorios();
      allow get: if podeOperacao()
        && movimentoId.matches('pedido-(site|manual)-.*');
      allow create, update: if isAdmin() || podeFinanceiro() || podeCaixa()
        || (podeOperacao() && movimentoAutomaticoPedidoValido(movimentoId))
        || (podeCompras() && movimentoAutomaticoCompraValido(movimentoId));
      allow delete: if isAdmin() || podeFinanceiro()
        || (podeOperacao() && resource.data.origem in ["pedido-site", "pedido-manual"]);
    }

    match /custosProdutos/{produtoId} {
      allow read: if isAdmin() || podeFinanceiro() || podeEstoque() || podeRelatorios();
      allow create, update, delete: if isAdmin() || podeFinanceiro();
    }

    match /contasReceber/{contaId} {
      allow read, create, update, delete: if isAdmin() || podeFinanceiro();
    }

    match /sessoesCaixa/{sessaoId} {
      allow read, create, update: if isAdmin() || podeCaixa() || podeFinanceiro();
      allow delete: if isAdmin();
    }

    match /fechamentosFinanceiros/{mesId} {
      allow read, create, update, delete: if isAdmin() || podeFinanceiro();
    }

    match /cardapiosDiarios/{data} {
      allow read: if true;
      allow create, update: if isAdmin() || podePedidos() || podeConfiguracoes();
      allow delete: if isAdmin();
    }

    match /estoqueInsumos/{id} {
      allow read: if isAdmin() || podeEstoque() || podeCompras() || podeRelatorios();
      allow create, update: if isAdmin() || podeEstoque() || podeCompras();
      allow delete: if isAdmin();
    }

    match /movimentacoesEstoque/{id} {
      allow read: if isAdmin() || podeEstoque() || podeCompras() || podeRelatorios();
      allow create: if isAdmin() || podeEstoque() || podeCompras();
      allow update, delete: if isAdmin();
    }

    match /fichasTecnicas/{id} {
      allow read: if isAdmin() || podeEstoque() || podeCompras() || podeFinanceiro() || podeRelatorios();
      allow create, update: if isAdmin() || podeEstoque() || podeFinanceiro();
      allow delete: if isAdmin();
    }

    match /perdasEstoque/{id} {
      allow read: if isAdmin() || podeEstoque() || podeFinanceiro() || podeRelatorios();
      allow create: if isAdmin() || podeEstoque();
      allow update, delete: if isAdmin();
    }

    match /fornecedores/{id} {
      allow read: if isAdmin() || podeCompras() || podeFinanceiro();
      allow create, update: if isAdmin() || podeCompras();
      allow delete: if isAdmin();
    }

    match /compras/{id} {
      allow read: if isAdmin() || podeCompras() || podeFinanceiro() || podeRelatorios();
      allow create, update: if isAdmin() || podeCompras();
      allow delete: if isAdmin();
    }

    match /movimentosCaixa/{id} {
      allow read, create: if isAdmin() || podeCaixa() || podeFinanceiro();
      allow update, delete: if isAdmin();
    }

    match /equipe/{uid} {
      allow read: if isAdmin() || (logado() && request.auth.uid == uid);
      allow create: if isAdmin() || ativacaoConviteEquipeValida(uid);
      allow update, delete: if isAdmin();
    }

    match /convitesEquipe/{email} {
      allow read: if isAdmin() || (logado()
        && request.auth.token.email is string
        && email == request.auth.token.email.lower()
        && resource.data.email == request.auth.token.email.lower());
      allow create, update, delete: if isAdmin();
    }

    match /solicitacoesAcesso/{uid} {
      allow create: if isAdmin() || (logado() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email);
      allow read: if isAdmin() || (logado() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
