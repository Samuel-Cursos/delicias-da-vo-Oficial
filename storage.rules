rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "deliciasdavo54@gmail.com";
    }

    function podeEditarSite() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/equipe/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/equipe/$(request.auth.uid)).data.ativo == true
        && firestore.get(/databases/(default)/documents/equipe/$(request.auth.uid)).data.permissoes.site == true;
    }

    match /produtos/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isAdmin() || podeEditarSite())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin() || podeEditarSite();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
